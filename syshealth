  sh_run failed_units 15 'failed systemd units' 'systemctl --failed --no-legend --no-pager'
  sh_run error_units 60 'units with err-level journal entries in the last 24 h, and their state now' sh_error_units
  sh_run journal_errors 60 'err-level journal entries, last 24 h, newest 50' \
