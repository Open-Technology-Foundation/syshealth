#!/usr/bin/bash

# Require Bash 5.2+ before any version-gated builtin (inherit_errexit, ${var@Q})
((BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 2))) \
  || { >&2 printf '%s: requires Bash >= 5.2 (have %s)\n' "${0##*/}" "${BASH_VERSION:-unknown}"; exit 2; }

set -euo pipefail
shopt -s inherit_errexit shift_verbose extglob nullglob

# SysHealth - System health monitoring and AI analysis tool
# Collects system information and uses LLM APIs to generate health reports

# Security: lock down PATH and IFS
readonly -- PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
IFS=$' \t\n'

declare -r VERSION=2.0.0
SCRIPT_PATH=$(realpath -- "$0")
readonly -- SCRIPT_PATH
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

# Hardcoded defaults
declare -- MODEL=claude-sonnet-4-5
# 8192 stays within the output caps of the documented non-Claude models
# (gpt-4o 16384, deepseek 8192, gemini/grok); raise via SYSHEALTH_MAX_TOKENS
# for very detailed Claude reports.
declare -i MAX_TOKENS=8192
declare -- TEMPERATURE=0.1
declare -i API_TIMEOUT=420
declare -- OUTPUT_DIR="$HOME/syshealth"
declare -- LANGUAGE=en
declare -- MAIL_RECIPIENTS=''

# Provider settings (derived from MODEL at runtime)
declare -- PROVIDER=''
declare -- API_URL=''
declare -- API_KEY=''

# Thresholds
declare -i DISK_WARN=80 DISK_CRIT=90
declare -i MEM_WARN=85 MEM_CRIT=95
declare -- CPU_WARN=2.0

# Load system config (env vars take precedence over config file)
declare -r SYSHEALTH_CONF=/etc/syshealth/syshealth.conf
if [[ -r "$SYSHEALTH_CONF" ]]; then
  # Preserve env vars so config file doesn't clobber them
  declare -- _saved_anthropic=${ANTHROPIC_API_KEY:-}
  declare -- _saved_openai=${OPENAI_API_KEY:-}
  declare -- _saved_gemini=${GEMINI_API_KEY:-}
  declare -- _saved_deepseek=${DEEPSEEK_API_KEY:-}
  declare -- _saved_xai=${XAI_API_KEY:-}
  declare -- _saved_ollama=${OLLAMA_HOST:-}
  # shellcheck source=/dev/null
  . "$SYSHEALTH_CONF"
  # Restore env vars over config values
  [[ -n "$_saved_anthropic" ]] && ANTHROPIC_API_KEY=$_saved_anthropic
  [[ -n "$_saved_openai" ]]    && OPENAI_API_KEY=$_saved_openai
  [[ -n "$_saved_gemini" ]]    && GEMINI_API_KEY=$_saved_gemini
  [[ -n "$_saved_deepseek" ]]  && DEEPSEEK_API_KEY=$_saved_deepseek
  [[ -n "$_saved_xai" ]]       && XAI_API_KEY=$_saved_xai
  [[ -n "$_saved_ollama" ]]    && OLLAMA_HOST=$_saved_ollama
  unset _saved_anthropic _saved_openai _saved_gemini _saved_deepseek _saved_xai _saved_ollama
fi

# Environment variables override config file. Integer values are validated
# before assignment: a non-numeric env var would otherwise abort with an opaque
# "unbound variable" from the declare -i arithmetic context (set -u).
[[ -n "${SYSHEALTH_MODEL:-}" ]] && MODEL=$SYSHEALTH_MODEL
if [[ -n "${SYSHEALTH_MAX_TOKENS:-}" ]]; then
  [[ $SYSHEALTH_MAX_TOKENS == +([0-9]) ]] \
    || { >&2 printf '%s: SYSHEALTH_MAX_TOKENS must be a positive integer (got %q)\n' "${0##*/}" "$SYSHEALTH_MAX_TOKENS"; exit 2; }
  MAX_TOKENS=$SYSHEALTH_MAX_TOKENS
fi
[[ -n "${SYSHEALTH_TEMPERATURE:-}" ]] && TEMPERATURE=$SYSHEALTH_TEMPERATURE
if [[ -n "${SYSHEALTH_TIMEOUT:-}" ]]; then
  [[ $SYSHEALTH_TIMEOUT == +([0-9]) ]] \
    || { >&2 printf '%s: SYSHEALTH_TIMEOUT must be a positive integer (got %q)\n' "${0##*/}" "$SYSHEALTH_TIMEOUT"; exit 2; }
  API_TIMEOUT=$SYSHEALTH_TIMEOUT
fi
[[ -n "${SYSHEALTH_OUTPUT_DIR:-}" ]] && OUTPUT_DIR=$SYSHEALTH_OUTPUT_DIR
[[ -n "${SYSHEALTH_LANGUAGE:-}" ]]   && LANGUAGE=$SYSHEALTH_LANGUAGE

# Validate the final temperature (string-typed; covers config-file and env so a
# bad value fails fast here instead of as a misleading "API request failed" in jq)
[[ $TEMPERATURE == +([0-9]) || $TEMPERATURE == +([0-9]).*([0-9]) ]] \
  || { >&2 printf '%s: TEMPERATURE must be numeric, e.g. 0.1 (got %q)\n' "${0##*/}" "$TEMPERATURE"; exit 2; }

# Flags
declare -i VERBOSE=0 DEBUG=0 QUIET=0

# TTY-aware colors
if [[ -t 1 && -t 2 ]]; then
  declare -r NC=$'\033[0m'
  declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m'
  declare -r YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m'
else
  declare -r NC='' RED='' GREEN='' YELLOW='' CYAN=''
fi

# --------------------------------------------------------------------------------
# Messaging functions
# --------------------------------------------------------------------------------

_msg() {
  local -- caller=${FUNCNAME[1]:-info}
  local -- prefix icon color
  case $caller in
    info)    icon='◉'; color="$CYAN" ;;
    warn)    icon='▲'; color="$YELLOW" ;;
    error)   icon='✗'; color="$RED" ;;
    success) icon='✓'; color="$GREEN" ;;
    vecho)   icon='◉'; color="$CYAN" ;;
    debug)   icon='⦿'; color="$CYAN" ;;
    *)       icon='◉'; color="$CYAN" ;;
  esac
  prefix="${color}${icon}${NC}"
  >&2 printf '%s %s\n' "$prefix" "$*"
}

vecho()   { ((VERBOSE)) || return 0; _msg "$@"; }
info()    { ((QUIET)) && return 0 ||:; _msg "$@"; }
warn()    { _msg "$@"; }
error()   { _msg "$@"; }
success() { _msg "$@"; }
debug()   { ((DEBUG)) || return 0; _msg "$@"; }
die()     { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }
noarg()   { (($# > 1)) && [[ ${2:0:1} != '-' ]] || die 2 "Option ${1@Q} requires an argument"; }

# --------------------------------------------------------------------------------
# Utility functions
# --------------------------------------------------------------------------------

check_dependencies() {
  local -- cmd
  for cmd in curl jq; do
    command -v "$cmd" >/dev/null || die 18 "'$cmd' required (apt install $cmd)"
  done

  # Resolve provider from model name and load API key
  resolve_provider
  resolve_api_key

  # Check Ollama reachability (warning only)
  if [[ "$PROVIDER" == ollama ]]; then
    local -- ollama_base=${API_URL%/v1/chat/completions}
    curl -sf --max-time 5 "${ollama_base}/api/tags" >/dev/null 2>&1 \
      || warn "Ollama not reachable at $ollama_base"
  fi

  # Warn about recommended tools
  local -a missing=()
  for cmd in lshw lscpu df free ss lsblk smartctl; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
  done
  ((!${#missing[@]})) || warn "Missing recommended tools: ${missing[*]}"
}

sanitize_filename() {
  local -- input=$1
  # Strip path separators and special chars, keep alphanumeric, dots, hyphens, underscores
  input=${input//[^a-zA-Z0-9._-]/}
  echo "$input"
}

run_cmd() {
  local -- host=$1 cmd=$2
  if [[ "$host" == "$HOSTNAME" || "$host" == localhost ]]; then
    bash -c "$cmd" 2>&1 ||:
  else
    ssh -o ConnectTimeout=30 -o BatchMode=yes -o StrictHostKeyChecking=yes \
      "$host" "$cmd" 2>&1 ||:
  fi
}

check_host_reachable() {
  # Preflight gate: verify a remote host answers SSH before any collection.
  # Prevents fabricating a "health report" out of SSH connection-error text,
  # which run_cmd's '2>&1 ||:' would otherwise capture as exit-0 output.
  local -- host=$1
  if [[ "$host" == "$HOSTNAME" || "$host" == localhost ]]; then
    return 0
  fi
  ssh -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=yes \
    "$host" true 2>/dev/null
}

json_encode() {
  # Safely JSON-encode stdin using jq
  jq -Rs .
}

resolve_provider() {
  # Auto-detect provider from MODEL name — sets PROVIDER and API_URL
  case $MODEL in
    claude-*)
      PROVIDER=anthropic
      API_URL='https://api.anthropic.com/v1/messages'
      ;;
    gpt-*|chatgpt-*|o[0-9]*)
      # o[0-9]* covers bare (o1, o3) and suffixed (o3-mini, o4-mini) reasoning
      # model names, plus future o-series, that the old o1-*/o3-*/o4-* globs missed
      PROVIDER=openai
      API_URL='https://api.openai.com/v1/chat/completions'
      ;;
    gemini-*)
      PROVIDER=gemini
      API_URL='https://generativelanguage.googleapis.com/v1beta/openai/chat/completions'
      ;;
    deepseek-*)
      PROVIDER=deepseek
      API_URL='https://api.deepseek.com/chat/completions'
      ;;
    grok-*)
      PROVIDER=xai
      API_URL='https://api.x.ai/v1/chat/completions'
      ;;
    *)
      PROVIDER=ollama
      API_URL="${OLLAMA_HOST:-http://localhost:11434}/v1/chat/completions"
      ;;
  esac
  vecho "Provider: $PROVIDER ($API_URL)"
}

resolve_api_key() {
  # Resolve API key for the active provider
  case $PROVIDER in
    ollama)
      API_KEY=''
      return 0
      ;;
    anthropic)
      # Anthropic: env var > key files
      API_KEY=${ANTHROPIC_API_KEY:-}
      if [[ -z "$API_KEY" ]]; then
        local -- keyfile
        for keyfile in \
          /etc/anthropic/api_key \
          "${XDG_CONFIG_HOME:-$HOME/.config}"/anthropic/api_key; do
          if [[ -f "$keyfile" && -r "$keyfile" ]]; then
            API_KEY=$(< "$keyfile")
            API_KEY=${API_KEY%%[[:space:]]*}
            debug "API key loaded from $keyfile"
          fi
        done
      fi
      [[ -n "$API_KEY" ]] || die 1 \
        'ANTHROPIC_API_KEY not set. Set env var or create ~/.config/anthropic/api_key'
      ;;
    openai)   API_KEY=${OPENAI_API_KEY:-}   ;;
    gemini)   API_KEY=${GEMINI_API_KEY:-}    ;;
    deepseek) API_KEY=${DEEPSEEK_API_KEY:-}  ;;
    xai)      API_KEY=${XAI_API_KEY:-}       ;;
  esac

  # Non-Ollama, non-Anthropic: check key is present
  if [[ "$PROVIDER" != anthropic && "$PROVIDER" != ollama && -z "$API_KEY" ]]; then
    local -- key_var
    case $PROVIDER in
      openai)   key_var=OPENAI_API_KEY   ;;
      gemini)   key_var=GEMINI_API_KEY   ;;
      deepseek) key_var=DEEPSEEK_API_KEY ;;
      xai)      key_var=XAI_API_KEY      ;;
    esac
    die 1 "$key_var not set for provider ${PROVIDER@Q}"
  fi
}

