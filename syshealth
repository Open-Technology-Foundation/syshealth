#!/usr/bin/bash
# syshealth - collect a Linux host's health data and have an LLM write the report
#
# Dual-purpose: executed, it runs main(); sourced (by tests/syshealth.bats), it
# only defines the settings and functions above the source fence.

# --------------------------------------------------------------------------------
# Metadata and settings

# Readonly metadata
# (guarded by a name only this block sets: sourcing the file again must not
# redeclare it, and a VERSION already in the environment must not skip it)
[[ -v SYSHEALTH_METADATA ]] || {
  declare -r SYSHEALTH_METADATA=1
  declare -r VERSION=3.0.0
  declare -r SCRIPT_NAME=${BASH_SOURCE[0]##*/}
  # Claude API version; 2026-10-21 rejects temperature, top_p and top_k on every model
  declare -r ANTHROPIC_VERSION=2026-10-21
  # Beta that lets a declined request fall back to the model Anthropic picks
  declare -r FALLBACK_BETA=server-side-fallback-2026-07-01
  # TTY-aware colors
  if [[ -t 1 && -t 2 ]]; then
    declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
  else
    declare -r RED='' GREEN='' YELLOW='' CYAN='' NC=''
  fi
}

# Default settings
# Precedence: built-in defaults < config files < environment < command line.
# Numbers stay strings until validate_settings() has checked them, so a bad
# value in a config file is reported, not evaluated as arithmetic.
declare -- MODEL=claude-opus-5-5
declare -- MAX_TOKENS=0              # 0 = provider default, see resolve_provider()
declare -- TEMPERATURE=0.1           # OpenAI-compatible providers only
declare -- EFFORT=''                 # Claude output_config.effort; '' = model default
declare -- API_TIMEOUT=900
declare -- COLLECT_TIMEOUT=600
declare -- OUTPUT_DIR="$HOME"/syshealth
declare -- LANGUAGE=en
declare -- MAIL_RECIPIENTS=''
declare -- MAIL_FROM="SysHealth <syshealth@$HOSTNAME>"
declare -- CONTEXT_DIR=/etc/syshealth/hosts
declare -a EXTRA_COMMANDS=()
declare -- DISK_WARN=80 DISK_CRIT=90
declare -- MEM_WARN=85 MEM_CRIT=95
declare -- LOAD_WARN=1.0             # load average per CPU core
declare -- MAX_SECTION_LINES=200 MAX_LINE_CHARS=500

declare -a CONF_FILES=(
  /etc/syshealth/syshealth.conf
  "${XDG_CONFIG_HOME:-$HOME/.config}"/syshealth/syshealth.conf
)
# Variables whose environment value wins over one set in a config file
declare -a ENV_WINS=(
  ANTHROPIC_API_KEY ANTHROPIC_BASE_URL OPENAI_API_KEY GEMINI_API_KEY
  DEEPSEEK_API_KEY XAI_API_KEY OLLAMA_HOST
)

# Command-line flags
declare -i VERBOSE=1 DEBUG=0 DRY_RUN=0

# Runtime state
declare -- PROVIDER='' API_URL='' API_KEY='' TEMP_DIR=''
declare -a CONF_READ=()              # config files actually sourced
declare -- COLLECTED_AT='' RESP_MODEL='' RESP_USAGE=''
# Collector side: the section-marker nonce and the PID whose process tree is
# the collector's own session (both set in the script sent to the host)
declare -- SH_NONCE='' SH_ROOT=''

# --------------------------------------------------------------------------------
# Messaging and helpers

# Message functions

_msg() {
  local -- status=$1 line
  shift
  for line in "$@"; do
    >&2 printf '%s: %s %s\n' "$SCRIPT_NAME" "$status" "$line"
  done
}

info()    { ((VERBOSE)) || return 0; _msg "$CYAN◉$NC" "$@"; }
vecho()   { ((VERBOSE > 1)) || return 0; _msg "$CYAN◉$NC" "$@"; }
success() { ((VERBOSE)) || return 0; _msg "$GREEN✓$NC" "$@"; }
warn()    { _msg "$YELLOW▲$NC" "$@"; }
error()   { _msg "$RED✗$NC" "$@"; }
debug()   { ((DEBUG)) || return 0; _msg "$CYAN⦿$NC" "$@"; }
die()     { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }
noarg()   { (($# > 1)) || die 22 "Option ${1@Q} requires an argument"; }

# Usage message

show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Linux health reports written by an LLM

Collects health data from this host or, over SSH, from remote hosts, and has
an LLM (Claude by default) write a Markdown report: findings ranked by
severity, each with its evidence, and the commands to fix or check them.

Usage: $SCRIPT_NAME [OPTIONS] [HOST...]

Options:
  -m, --model MODEL      Model (default: $MODEL); the provider follows from it:
                           claude-*                    Anthropic
                           gpt-*, chatgpt-*, o1, o3..  OpenAI
                           gemini-*                    Google Gemini
                           deepseek-*                  DeepSeek
                           grok-*                      xAI
                           anything else               Ollama (local)
  -e, --effort LEVEL     Claude effort: low, medium, high, xhigh or max
                         (default: the model's own)
  -L, --language LANG    Report language (default: $LANGUAGE)
  -o, --output-dir DIR   Directory for reports (default: $OUTPUT_DIR)
      --mail ADDRESSES   Mail each report to these comma-separated addresses
  -n, --dry-run          Collect the data and print the prompt; no API call,
                         no report, no mail
  -v, --verbose          More progress detail, and print each report
  -q, --quiet            Only warnings and errors
  -D, --debug            Name the config files read, and keep the collected
                         data, prompt and API response in OUTPUT_DIR/debug/
                         (implies -v)
  -V, --version          Show the version
  -h, --help             Show this help

Hosts are SSH destinations (key authentication, known host keys only). With
none, this host is analysed.

Files:
  /etc/syshealth/syshealth.conf, ~/.config/syshealth/syshealth.conf
      Settings, sourced as Bash in that order (see syshealth.conf.example).
      Ignored unless owned by root or you and not group- or world-writable.
  CONTEXT_DIR/common.md, CONTEXT_DIR/HOST.md  (CONTEXT_DIR: $CONTEXT_DIR)
      Operator notes on a host: its role, intentional setups, known false
      positives. The model treats them as trusted context.

Environment (wins over the config files; options win over both):
  ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, DEEPSEEK_API_KEY,
  XAI_API_KEY        API key for the provider
  ANTHROPIC_BASE_URL Claude API base URL (default https://api.anthropic.com)
  OLLAMA_HOST        Ollama URL (default http://localhost:11434)
  SYSHEALTH_CONF     The one config file to read instead of the two above
                     ('' for none)
  SYSHEALTH_MODEL, SYSHEALTH_MAX_TOKENS, SYSHEALTH_TEMPERATURE,
