# --------------------------------------------------------------------------------
# Data collection functions
# --------------------------------------------------------------------------------

collect_basic() {
  local -- host=$1
  local -- uname os_release uptime_info time_sync virt container

  vecho "Collecting basic system info from $host..."
  uname=$(run_cmd "$host" 'uname -a' | json_encode)
  os_release=$(run_cmd "$host" 'lsb_release -a 2>/dev/null || cat /etc/*release 2>/dev/null' | json_encode)
  uptime_info=$(run_cmd "$host" 'uptime' | json_encode)
  time_sync=$(run_cmd "$host" 'timedatectl status 2>/dev/null || chronyc tracking 2>/dev/null || ntpq -p 2>/dev/null || echo "Time synchronization information not available"' | json_encode)
  virt=$(run_cmd "$host" 'systemd-detect-virt 2>/dev/null || dmesg | grep -i hypervisor | head -5 2>/dev/null || echo "Virtualization info not available"' | json_encode)
  container=$(run_cmd "$host" 'cat /proc/1/cgroup 2>/dev/null | head -5 || echo "Container information not available"' | json_encode)

  printf '"hostname": %s,\n' "$(echo "$host" | json_encode)"
  printf '"timestamp": %s,\n' "$(date -Iseconds | json_encode)"
  printf '"uname": %s,\n' "$uname"
  printf '"os_release": %s,\n' "$os_release"
  printf '"uptime": %s,\n' "$uptime_info"
  printf '"time_sync": %s,\n' "$time_sync"
  printf '"virtualization": %s,\n' "$virt"
  printf '"container_info": %s,\n' "$container"
}

collect_hardware() {
  local -- host=$1
  local -- hardware cpu_model cpu_info memory swap_info temperature

  vecho "Collecting hardware info from $host..."
  hardware=$(run_cmd "$host" 'lshw -short 2>/dev/null || echo "Hardware listing unavailable (install: sudo apt install lshw)"' | json_encode)
  cpu_model=$(run_cmd "$host" "lscpu | grep 'Model name' 2>/dev/null || grep -i cpu /proc/cpuinfo | grep -i model | head -1" | json_encode)
  cpu_info=$(run_cmd "$host" 'lscpu 2>/dev/null || cat /proc/cpuinfo || echo "CPU information unavailable"' | json_encode)
  memory=$(run_cmd "$host" 'free -h' | json_encode)
  swap_info=$(run_cmd "$host" 'grep -i swap /proc/swaps 2>/dev/null || echo "Swap information not available"' | json_encode)
  temperature=$(run_cmd "$host" 'sensors 2>/dev/null || cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null || echo "Temperature information not available (install: sudo apt install lm-sensors)"' | json_encode)

  printf '"hardware": %s,\n' "$hardware"
  printf '"cpu_model": %s,\n' "$cpu_model"
  printf '"cpu_info": %s,\n' "$cpu_info"
  printf '"memory": %s,\n' "$memory"
  printf '"swap_info": %s,\n' "$swap_info"
  printf '"temperature": %s,\n' "$temperature"
}

collect_storage() {
  local -- host=$1
  local -- disk_usage block_devs fstab raid_status raid_detail
  local -- lvm_vols lvm_groups lvm_phys disk_health

  vecho "Collecting storage info from $host..."
  disk_usage=$(run_cmd "$host" 'df -h' | json_encode)
  block_devs=$(run_cmd "$host" 'lsblk --noheadings --output NAME,SIZE,TYPE,MOUNTPOINT 2>/dev/null || echo "Block device information not available"' | json_encode)
  fstab=$(run_cmd "$host" "cat /etc/fstab | grep -vE '^(#|\$)' 2>/dev/null || echo 'fstab not available'" | json_encode)
  raid_status=$(run_cmd "$host" 'cat /proc/mdstat 2>/dev/null || echo "No software RAID configured"' | json_encode)
  raid_detail=$(run_cmd "$host" 'mdadm --detail --scan 2>/dev/null || echo "mdadm not available or no RAID configured"' | json_encode)
  lvm_vols=$(run_cmd "$host" 'lvs --noheadings 2>/dev/null || echo "LVM not configured or lvs not available"' | json_encode)
  lvm_groups=$(run_cmd "$host" 'vgs --noheadings 2>/dev/null || echo "LVM not configured or vgs not available"' | json_encode)
  lvm_phys=$(run_cmd "$host" 'pvs --noheadings 2>/dev/null || echo "LVM not configured or pvs not available"' | json_encode)

  # Dynamic disk health detection — check SMART on all physical disks
  local -- disk_list
  disk_list=$(run_cmd "$host" 'lsblk --noheadings --output NAME,TYPE 2>/dev/null')
  local -a disks=()
  local -- line dname health_results='' disk health
  if [[ -n "$disk_list" ]]; then
    while IFS= read -r line; do
      if [[ "$line" == *disk* ]]; then
        dname=${line%% *}
        dname=${dname// /}
        # Skip zd (ZFS) devices
        [[ "$dname" == zd* ]] || disks+=("$dname")
      fi
    done <<< "$disk_list"
  fi
  ((${#disks[@]})) || disks=(nvme0n1)

  for disk in "${disks[@]}"; do
    health=$(run_cmd "$host" "timeout 30s smartctl -H /dev/$disk 2>/dev/null || echo 'SMART data unavailable for $disk (requires root or smartctl not installed)'")
    health_results+="=== /dev/$disk ===
$health

"
  done
  disk_health=$(echo "$health_results" | json_encode)

  printf '"disk_usage": %s,\n' "$disk_usage"
  printf '"block_devices": %s,\n' "$block_devs"
  printf '"disk_health": %s,\n' "$disk_health"
  printf '"fstab": %s,\n' "$fstab"
  printf '"raid_status": %s,\n' "$raid_status"
  printf '"raid_detail": %s,\n' "$raid_detail"
  printf '"lvm_volumes": %s,\n' "$lvm_vols"
  printf '"lvm_groups": %s,\n' "$lvm_groups"
  printf '"lvm_physical": %s,\n' "$lvm_phys"
}

collect_process() {
  local -- host=$1
  local -- top_cpu top_mem

  vecho "Collecting process info from $host..."
  top_cpu=$(run_cmd "$host" 'ps --no-headers -eo pid,pcpu,pmem,comm --sort=-%cpu | head -n 10' | json_encode)
  top_mem=$(run_cmd "$host" 'ps --no-headers -eo pid,pcpu,pmem,comm --sort=-%mem | head -n 10' | json_encode)

  printf '"top_cpu_processes": %s,\n' "$top_cpu"
  printf '"top_mem_processes": %s,\n' "$top_mem"
}

collect_network() {
  local -- host=$1
  local -- interfaces ports

  vecho "Collecting network info from $host..."
  interfaces=$(run_cmd "$host" 'ip -br addr show 2>/dev/null || ip addr show 2>/dev/null || ifconfig 2>/dev/null || cat /proc/net/dev 2>/dev/null || echo "Network information not available"' | json_encode)
  ports=$(run_cmd "$host" 'timeout 15s ss -tuln 2>/dev/null || timeout 15s netstat -tuln 2>/dev/null || echo "Port information not available"' | json_encode)

  printf '"network_interfaces": %s,\n' "$interfaces"
  printf '"listening_ports": %s,\n' "$ports"
}

collect_security() {
  local -- host=$1
  local -- failed_svc errors auth updates rootkit cron firewall

  vecho "Collecting security info from $host..."
  failed_svc=$(run_cmd "$host" 'timeout 15s systemctl list-units --state=failed 2>/dev/null || echo "Failed services information not available"' | json_encode)
  errors=$(run_cmd "$host" 'timeout 30s journalctl -p err --lines=20 --no-pager -q 2>/dev/null || echo "Error logs not available"' | json_encode)
  auth=$(run_cmd "$host" 'grep -i fail /var/log/auth.log 2>/dev/null | tail -20 || echo "Authentication logs not available"' | json_encode)
  updates=$(run_cmd "$host" 'apt list --upgradable 2>/dev/null | head -20 || echo "Update information not available"' | json_encode)
  rootkit=$(run_cmd "$host" 'cat /var/log/chkrootkit/log.today 2>/dev/null || echo "Rootkit check logs not available (install: sudo apt install chkrootkit)"' | json_encode)
  cron=$(run_cmd "$host" "crontab -l | grep -vE '^(#|\$)' 2>/dev/null || echo 'Crontab information not available'" | json_encode)
  firewall=$(run_cmd "$host" 'ufw status verbose 2>/dev/null || iptables -L -n -v 2>/dev/null || echo "Firewall information not available (requires root)"' | json_encode)

  printf '"failed_services": %s,\n' "$failed_svc"
  printf '"recent_errors": %s,\n' "$errors"
  printf '"auth_failures": %s,\n' "$auth"
  printf '"available_updates": %s,\n' "$updates"
  printf '"rootkit_check": %s,\n' "$rootkit"
  printf '"cron_jobs": %s,\n' "$cron"
  # Last field — no trailing comma
  printf '"firewall": %s\n' "$firewall"
}

# --------------------------------------------------------------------------------
# JSON assembly
# --------------------------------------------------------------------------------

build_system_info() {
  local -- host=$1
  {
    printf '{\n'
    collect_basic "$host"
    collect_hardware "$host"
    collect_storage "$host"
    collect_process "$host"
    collect_network "$host"
    collect_security "$host"
    printf '}\n'
  } | jq .
}

# --------------------------------------------------------------------------------
# LLM API
# --------------------------------------------------------------------------------

build_prompt() {
  local -- system_json=$1

  cat <<EOF
You are a skilled system administrator tasked with analyzing a Linux system's health.
Analyze the following system information and create a comprehensive health report.

The report should be in markdown format with these sections:
1. System Overview - Brief overview of the system (hostname, OS version, uptime)
2. Hardware Configuration - Details about CPU, memory, and other hardware components
3. Storage Status - Disk usage, mount points, block devices, and potential issues
4. Memory Usage - RAM and swap usage, memory allocation, and potential issues
5. CPU Performance - CPU load, utilization, top processes, and potential bottlenecks
6. Network Configuration - Network interfaces, listening ports, and potential issues
7. System Health - Failed services, system errors, auth failures, available updates
8. Critical Issues - Highlight any critical issues that need immediate attention
9. Warnings - Highlight potential problems that aren't yet critical
10. Recommendations - Specific suggestions for improving system health and performance

Be direct and critical in your assessment. Focus on potential problems and their solutions.

Look for these critical issues (include in Critical Issues section):
- Very high disk usage (>${DISK_CRIT}% is critical)
- Critical memory shortage (<$((100 - MEM_CRIT))% available)
- High swap usage (>80% used)
- Failed system services
- Root or privileged access attempts
- Signs of system compromise
- Disk health problems (SMART errors)
- Kernel-level errors
- Authentication security issues

Look for these warning signs (include in Warnings section):
- High disk usage (>${DISK_WARN}% is concerning)
- Low memory availability (<$((100 - MEM_WARN))% available)
- Moderate swap usage
- High CPU load sustained over time (>${CPU_WARN} load average)
- Unusual network connections or listening ports
- Multiple authentication failures
- Outdated packages with security implications
- Unusual cron jobs or scheduled tasks

Recommendations should be specific to the system's issues, not generic advice.
For example, if a specific partition is running out of space, recommend actions for that partition.

Output language: ${LANGUAGE}

System Information:
-------------------
${system_json}
EOF
}

call_api() {
  local -- system_json=$1
  local -- prompt
  prompt=$(build_prompt "$system_json")

  debug "Calling $PROVIDER API with model: $MODEL"

  local -- response text err_msg

  if [[ "$PROVIDER" == anthropic ]]; then
    # Anthropic Messages API format
    response=$(
      printf '%s' "$prompt" |
      jq -Rs \
        --arg model "$MODEL" \
        --argjson max_tokens "$MAX_TOKENS" \
        --arg temp "$TEMPERATURE" \
        '{model:$model, max_tokens:$max_tokens, temperature:($temp|tonumber),
          messages:[{role:"user", content:.}]}' |
      curl -s --max-time "$API_TIMEOUT" --retry 3 --retry-delay 2 \
        -K <(printf -- '-H "x-api-key: %s"\n' "$API_KEY") \
        -H 'content-type: application/json' \
        -H 'anthropic-version: 2023-06-01' \
        -d @- \
        "$API_URL"
    ) || { error 'API request failed'; return 23; }

    text=$(jq -r '.content[0].text // empty' <<< "$response")
    if [[ -z "$text" ]]; then
      err_msg=$(jq -r '.error.message // .error.type // "Unknown API error"' <<< "$response")
      error "API error: $err_msg"
      return 1
    fi
  else
    # OpenAI-compatible chat completions format (OpenAI, Gemini, DeepSeek, xAI, Ollama)
    # Newer OpenAI reasoning / GPT-5 models reject `max_tokens` (require
    # `max_completion_tokens`) and reject any non-default `temperature`; the
    # other OpenAI-compatible providers still use max_tokens + temperature.
    local -- token_field='max_tokens'
    local -i send_temp=1
    if [[ $PROVIDER == openai ]]; then
      case $MODEL in
        o[0-9]*|gpt-5*) token_field='max_completion_tokens'; send_temp=0 ;;
      esac
    fi
    # $model/$tf/$max_tokens/$temp are jq --arg variables, not bash expansions
    local -- payload_filter
    if ((send_temp)); then
      # shellcheck disable=SC2016
      payload_filter='{model:$model, ($tf):$max_tokens, temperature:($temp|tonumber), messages:[{role:"user", content:.}]}'
    else
      # shellcheck disable=SC2016
      payload_filter='{model:$model, ($tf):$max_tokens, messages:[{role:"user", content:.}]}'
    fi
    response=$(
      printf '%s' "$prompt" |
      jq -Rs \
        --arg model "$MODEL" \
        --arg tf "$token_field" \
        --argjson max_tokens "$MAX_TOKENS" \
        --arg temp "$TEMPERATURE" \
        "$payload_filter" |
      if [[ -n "$API_KEY" ]]; then
        curl -s --max-time "$API_TIMEOUT" --retry 3 --retry-delay 2 \
          -K <(printf -- '-H "Authorization: Bearer %s"\n' "$API_KEY") \
          -H 'content-type: application/json' \
          -d @- \
          "$API_URL"
      else
        curl -s --max-time "$API_TIMEOUT" --retry 3 --retry-delay 2 \
          -H 'content-type: application/json' \
          -d @- \
          "$API_URL"
      fi
    ) || { error 'API request failed'; return 23; }

    text=$(jq -r '.choices[0].message.content // empty' <<< "$response")
    if [[ -z "$text" ]]; then
      err_msg=$(jq -r '.error.message // .error.type // "Unknown API error"' <<< "$response")
      error "API error: $err_msg"
      return 1
    fi
  fi

  echo "$text"
}

# --------------------------------------------------------------------------------
# Output functions
# --------------------------------------------------------------------------------

save_report() {
  local -- report=$1 host=$2 language=$3
  local -- safe_host safe_lang timestamp filename filepath

  safe_host=$(sanitize_filename "$host")
  safe_lang=$(sanitize_filename "$language")
  timestamp=$(date +'%Y%m%d-%H%M%S')
  filename="${safe_host}-${safe_lang}-${timestamp}.md"

  mkdir -p -- "$OUTPUT_DIR"
  filepath="$OUTPUT_DIR/$filename"

  printf '%s' "$report" > "$filepath"
  info "Report saved to: $filepath"
  echo "$filepath"
}

save_debug_prompt() {
  local -- prompt=$1 host=$2 language=$3
  local -- safe_host safe_lang timestamp filename debug_dir filepath

  safe_host=$(sanitize_filename "$host")
  safe_lang=$(sanitize_filename "$language")
  timestamp=$(date +'%Y%m%d-%H%M%S')
  filename="${safe_host}-${safe_lang}-prompt-${timestamp}.txt"
  debug_dir="$OUTPUT_DIR/debug"

  mkdir -p -- "$debug_dir"
  filepath="$debug_dir/$filename"

  printf '%s' "$prompt" > "$filepath"
  debug "Prompt saved to: $filepath"
}

send_email() {
  local -- report_path=$1 host=$2
  local -- report_content subject

  # Reject CR/LF in values that flow verbatim into RFC822 headers (header
  # injection / Bcc exfiltration). MAIL_RECIPIENTS is checked at parse time;
  # HOSTNAME is inherited from the environment, so re-check it here.
  if [[ $HOSTNAME == *[$'\r\n']* || $MAIL_RECIPIENTS == *[$'\r\n']* ]]; then
    warn "Refusing to send email for $host: CR/LF in HOSTNAME or recipients"
    return 1
  fi

  report_content=$(< "$report_path")
  subject="System Health Report for $(sanitize_filename "$host")"

  if command -v pandoc >/dev/null; then
    # Convert to HTML and send with attachment
    local -- html_content
    html_content=$(echo "$report_content" | pandoc -f markdown -t html 2>/dev/null) || html_content="<pre>$report_content</pre>"

    local -- boundary filename
    boundary="syshealth-$(date +%s)"
    filename=${report_path##*/}

    {
      printf 'Subject: %s\n' "$subject"
      printf 'From: SysHealth <syshealth@%s>\n' "$HOSTNAME"
      printf 'To: %s\n' "$MAIL_RECIPIENTS"
      printf 'MIME-Version: 1.0\n'
      printf 'Content-Type: multipart/mixed; boundary="%s"\n\n' "$boundary"
      printf -- '--%s\n' "$boundary"
      printf 'Content-Type: text/html; charset=utf-8\n\n'
      printf '%s\n\n' "$html_content"
      printf -- '--%s\n' "$boundary"
      printf 'Content-Type: text/plain; charset=utf-8\n'
      printf 'Content-Disposition: attachment; filename="%s"\n\n' "$filename"
      printf '%s\n' "$report_content"
      printf -- '--%s--\n' "$boundary"
    } | sendmail -t 2>/dev/null || {
      warn "Failed to send email for $host"
      return 1
    }
  else
    # Plain text fallback
    echo "$report_content" | mail -s "$subject" "$MAIL_RECIPIENTS" 2>/dev/null || {
      warn "Failed to send email for $host (install pandoc for HTML emails)"
      return 1
    }
  fi

  success "Email sent for $host to $MAIL_RECIPIENTS"
}

# --------------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------------

cleanup() {
  local -i exitcode=${1:-$?}
  trap - SIGINT SIGTERM EXIT
  exit "$exitcode"
}

main() {
  trap 'cleanup $?' SIGINT SIGTERM EXIT
  local -a hosts=()

  # Argument parsing
  while (($#)); do
    case $1 in
      -h|--help)    show_help; exit 0 ;;
      -V|--version) echo "$SCRIPT_NAME $VERSION"; exit 0 ;;
      -v|--verbose) VERBOSE+=1 ;;
      -d|--debug)   DEBUG=1; VERBOSE=1 ;;
      -q|--quiet)   QUIET=1 ;;
      -L|--language) noarg "$@"; shift; LANGUAGE=$1 ;;
      -m|--model)    noarg "$@"; shift; MODEL=$1 ;;
      -o|--output-dir) noarg "$@"; shift; OUTPUT_DIR=$1 ;;
      --mail)        noarg "$@"; shift; MAIL_RECIPIENTS=$1
                     [[ $MAIL_RECIPIENTS != *[$'\r\n']* ]] \
                       || die 22 'Invalid --mail value (contains CR/LF)' ;;
      -[vdqVh]*)
        # de-cluster combined short flags (-vd -> -v -d) without the
        # word-splitting + globbing of an unquoted command substitution
        local -a _flags=()
        local -i _i
        for ((_i=1; _i<${#1}; _i+=1)); do _flags+=("-${1:_i:1}"); done
        set -- '' "${_flags[@]}" "${@:2}"
        ;;
      -*)           die 22 "Invalid option ${1@Q}" ;;
      *)            hosts+=("$1") ;;
    esac
    shift
  done

  # Default to local hostname if no hosts specified
  ((${#hosts[@]})) || hosts=("$HOSTNAME")

  readonly -- MODEL LANGUAGE OUTPUT_DIR MAIL_RECIPIENTS
  readonly -- VERBOSE DEBUG QUIET MAX_TOKENS API_TIMEOUT

  check_dependencies

  readonly -- PROVIDER API_URL API_KEY

  mkdir -p -- "$OUTPUT_DIR" || die 1 "Cannot create output directory ${OUTPUT_DIR@Q}"

  local -a report_hosts=() report_files=() failed_hosts=()
  local -- host system_json prompt report report_path

  for host in "${hosts[@]}"; do
    info "Analyzing host: $host"

    # H1: verify reachability first — never build a report from SSH error text
    if ! check_host_reachable "$host"; then
      warn "Skipping unreachable host: $host"
      failed_hosts+=("$host")
      continue
    fi

    # H2: contain per-host failures so one host cannot abort the whole batch.
    # 'if !' suspends errexit/inherit_errexit for the substitution, so a failed
    # collector or jq validation surfaces as a nonzero result instead of exiting.
    if ! system_json=$(build_system_info "$host"); then
      warn "Skipping $host: system information collection failed"
      failed_hosts+=("$host")
      continue
    fi
    debug "Collected ${#system_json} bytes of system data"

    # Save debug prompt if in debug mode
    if ((DEBUG)); then
      prompt=$(build_prompt "$system_json")
      save_debug_prompt "$prompt" "$host" "$LANGUAGE"
    fi

    # Call LLM API
    if ! report=$(call_api "$system_json"); then
      warn "Skipping $host: API request failed"
      failed_hosts+=("$host")
      continue
    fi

    # Save report
    if ! report_path=$(save_report "$report" "$host" "$LANGUAGE"); then
      warn "Skipping $host: could not save report"
      failed_hosts+=("$host")
      continue
    fi
    report_hosts+=("$host")
    report_files+=("$report_path")

    # Display report if verbose
    if ((VERBOSE)); then
      printf '\n%s\n' '================================================================================'
      printf 'HEALTH REPORT FOR %s:\n' "$host"
      printf '%s\n' '================================================================================'
      printf '%s\n' "$report"
      printf '%s\n' '================================================================================'
    fi
  done

  # Send emails if requested (only for hosts that produced a report)
  if [[ -n "$MAIL_RECIPIENTS" ]]; then
    local -i i
    for ((i=0; i<${#report_hosts[@]}; i+=1)); do
      send_email "${report_files[$i]}" "${report_hosts[$i]}"
    done
  fi

  # Honest completion status — partial or total failure must not report success
  local -i ok=${#report_hosts[@]} failed=${#failed_hosts[@]}
  if ((!failed)); then
    success "All reports generated successfully ($ok host(s))"
  elif ((ok)); then
    warn "Completed with errors: $ok succeeded, $failed failed (${failed_hosts[*]})"
  else
    die 1 "All hosts failed (${failed_hosts[*]})"
  fi
}

main "$@"

