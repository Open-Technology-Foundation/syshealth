}

# Small helpers

# Keep alphanumerics, dot, hyphen and underscore; never return '', '.' or '..'
sanitize_filename() {
  local -- name=${1//[^a-zA-Z0-9._-]/}
  [[ -n $name && $name != +(.) ]] || name=unknown
  printf '%s\n' "$name"
}

# An SSH destination: [user@]host, never an option
valid_host() {
  [[ $1 =~ ^([A-Za-z0-9._-]+@)?[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

is_local_host() {
  [[ $1 == "$HOSTNAME" || $1 == localhost ]]
}

# Hex nonce from the kernel CSPRNG (SRANDOM), 128 bits
new_nonce() {
  printf '%08x%08x%08x%08x\n' "$SRANDOM" "$SRANDOM" "$SRANDOM" "$SRANDOM"
}

html_escape() {
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# The report language as the prompt names it: common ISO 639-1 codes are
# spelt out, anything else is passed through
language_name() {
  case ${LANGUAGE,,} in
    en) echo English ;;
    id) echo 'Indonesian (Bahasa Indonesia)' ;;
    ms) echo 'Malay (Bahasa Melayu)' ;;
    nl) echo Dutch ;;
    de) echo German ;;
    fr) echo French ;;
    es) echo Spanish ;;
    pt) echo Portuguese ;;
    zh) echo 'Chinese (Simplified)' ;;
    ja) echo Japanese ;;
    *)  printf '%s\n' "$LANGUAGE" ;;
  esac
}

# --------------------------------------------------------------------------------
# Configuration and provider

# A config file is sourced as Bash: only trust one owned by root or the
# current user that nobody else can write
conf_is_safe() {
  local -i owner
  local -- mode
  read -r owner mode < <(stat -Lc '%u %a' -- "$1") || return 1
  ((owner == 0 || owner == EUID)) && (((8#$mode & 8#022) == 0))
}

# Config files are sourced here, inside a function: they must use plain
# assignments (MODEL=..., EXTRA_COMMANDS=(...)); a 'declare' would be local.
# SYSHEALTH_CONF, when set, names the one file to read instead ('' for none).
load_config() {
  local -- _conf_file _env_name
  local -a _conf_files=("${CONF_FILES[@]}")
  local -A _env_value=() _env_map=(
    [SYSHEALTH_MODEL]=MODEL             [SYSHEALTH_MAX_TOKENS]=MAX_TOKENS
    [SYSHEALTH_TEMPERATURE]=TEMPERATURE [SYSHEALTH_EFFORT]=EFFORT
    [SYSHEALTH_TIMEOUT]=API_TIMEOUT     [SYSHEALTH_OUTPUT_DIR]=OUTPUT_DIR
    [SYSHEALTH_LANGUAGE]=LANGUAGE       [SYSHEALTH_CONTEXT_DIR]=CONTEXT_DIR
  )

  for _env_name in "${ENV_WINS[@]}"; do
    [[ -z ${!_env_name:-} ]] || _env_value[$_env_name]=${!_env_name}
  done

  if [[ -v SYSHEALTH_CONF ]]; then
    _conf_files=()
    [[ -z $SYSHEALTH_CONF ]] || _conf_files=("$SYSHEALTH_CONF")
  fi

  for _conf_file in "${_conf_files[@]}"; do
    if [[ ! -f $_conf_file ]]; then
      [[ ! -v SYSHEALTH_CONF ]] || warn "Config file ${_conf_file@Q} not found"
      continue
    fi
    if [[ ! -r $_conf_file ]]; then
      warn "Skipping ${_conf_file@Q}: not readable by $(id -un)"
      continue
    fi
    if ! conf_is_safe "$_conf_file"; then
      warn "Ignoring ${_conf_file@Q}: it must be owned by root or you and not writable by group or others"
      continue
    fi
    #shellcheck source=/dev/null
    source -- "$_conf_file"
    CONF_READ+=("$_conf_file")
  done

  for _env_name in "${!_env_value[@]}"; do
    printf -v "$_env_name" '%s' "${_env_value[$_env_name]}"
  done
  for _env_name in "${!_env_map[@]}"; do
    [[ -z ${!_env_name:-} ]] || printf -v "${_env_map[$_env_name]}" '%s' "${!_env_name}"
  done
}

validate_settings() {
  local -- var value addr
  local -- addr_re='^[[:space:]]*[^][:space:]@,<>"[]+@[^][:space:]@,<>"[]+[[:space:]]*$'
  local -- lang_re='^[[:alnum:]][[:alnum:] _-]*$'
  local -a addrs=()

  for var in MAX_TOKENS API_TIMEOUT COLLECT_TIMEOUT DISK_WARN DISK_CRIT MEM_WARN MEM_CRIT \
      MAX_SECTION_LINES MAX_LINE_CHARS; do
    value=${!var}
    [[ $value =~ ^[0-9]+$ ]] || die 22 "$var must be a whole number (got ${value@Q})"
  done
  for var in TEMPERATURE LOAD_WARN; do
    value=${!var}
    [[ $value =~ ^[0-9]+(\.[0-9]+)?$ ]] || die 22 "$var must be a number such as 0.1 (got ${value@Q})"
  done
  case $EFFORT in
    ''|low|medium|high|xhigh|max) ;;
    *) die 22 "Effort must be low, medium, high, xhigh or max (got ${EFFORT@Q})" ;;
  esac
  [[ $MODEL =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] || die 22 "Invalid model name ${MODEL@Q}"
  [[ $LANGUAGE =~ $lang_re ]] || die 22 "Invalid language ${LANGUAGE@Q}"
  [[ $MAIL_FROM != *[$'\r\n']* ]] || die 22 'MAIL_FROM must not contain a line break'

  if [[ -n $MAIL_RECIPIENTS ]]; then
    IFS=',' read -ra addrs <<< "$MAIL_RECIPIENTS"
    for addr in "${addrs[@]}"; do
      [[ $addr =~ $addr_re ]] || die 22 "Invalid mail address ${addr@Q}"
    done
  fi
}

# Provider and key

# Set PROVIDER and API_URL from the model name, and the provider's default
# output limit when none was set (thinking tokens count against it on Claude)
resolve_provider() {
  case $MODEL in
    claude-*)
      PROVIDER=anthropic
      API_URL=${ANTHROPIC_BASE_URL:-https://api.anthropic.com}
      API_URL=${API_URL%/}/v1/messages
      ;;
    gpt-*|chatgpt-*|o[0-9]*)
      PROVIDER=openai
      API_URL=https://api.openai.com/v1/chat/completions
      ;;
    gemini-*)
      PROVIDER=gemini
      API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
      ;;
    deepseek-*)
      PROVIDER=deepseek
      API_URL=https://api.deepseek.com/chat/completions
      ;;
    grok-*)
      PROVIDER=xai
      API_URL=https://api.x.ai/v1/chat/completions
      ;;
    *)
      PROVIDER=ollama
      API_URL=${OLLAMA_HOST:-http://localhost:11434}
      API_URL=${API_URL%/}/v1/chat/completions
      ;;
  esac
  if ((MAX_TOKENS == 0)); then
    case $PROVIDER in
      anthropic) MAX_TOKENS=32000 ;;
      openai)    MAX_TOKENS=16384 ;;
      *)         MAX_TOKENS=8192 ;;
    esac
  fi
  vecho "Provider $PROVIDER, model $MODEL, max_tokens $MAX_TOKENS"
}

# Server-side refusal fallback ("default" form) is accepted by these models only
claude_fallback_supported() {
  case $MODEL in
    claude-opus-5|claude-opus-5-5|claude-sonnet-5-5|claude-fable-5-1|claude-mythos-5-1) return 0 ;;
    *) return 1 ;;
  esac
}

# Load the provider's key into API_KEY. The key is never printed.
resolve_api_key() {
  local -- var keyfile
  case $PROVIDER in
    ollama)    API_KEY=''; return 0 ;;
    anthropic) var=ANTHROPIC_API_KEY ;;
    openai)    var=OPENAI_API_KEY ;;
    gemini)    var=GEMINI_API_KEY ;;
    deepseek)  var=DEEPSEEK_API_KEY ;;
    xai)       var=XAI_API_KEY ;;
    *)         die 1 "Unknown provider ${PROVIDER@Q}" ;;
  esac
  API_KEY=${!var:-}

  if [[ -z $API_KEY && $PROVIDER == anthropic ]]; then
    for keyfile in "${XDG_CONFIG_HOME:-$HOME/.config}"/anthropic/api_key /etc/anthropic/api_key; do
      [[ -f $keyfile && -r $keyfile ]] || continue
      # ||: read fails on a key file without a final newline, yet fills API_KEY
      read -r API_KEY < "$keyfile" ||:
      if [[ -n $API_KEY ]]; then
        debug "API key read from $keyfile"
        break
      fi
    done
  fi

  [[ -n $API_KEY ]] || die 1 "$var is not set (environment or config file)"
  # A line break or quote would break out of the curl config line that carries it
  [[ $API_KEY =~ ^[A-Za-z0-9._~+/=-]+$ ]] || die 22 "$var contains unexpected characters"
}

check_dependencies() {
  local -- cmd host
  local -a need=()
  ((DRY_RUN)) || need+=(curl jq)
  [[ -z $MAIL_RECIPIENTS ]] || need+=(sendmail)
  for host in "$@"; do
    if ! is_local_host "$host"; then
      need+=(ssh)
      break
    fi
  done
  for cmd in "${need[@]}"; do
    command -v "$cmd" >/dev/null || die 18 "${cmd@Q} is required"
  done
}

# --------------------------------------------------------------------------------
# Collector on the host

# These functions are sent to the host as text (declare -f), so they use only
# Bash and standard Linux tools and read no setting of this script. Each
# section starts with a marker line carrying SH_NONCE, a random value new for
# every run, so text already on the host cannot pass itself off as a section.

sh_section() {
  printf '\n@@%s@@ %s|%s\n' "$SH_NONCE" "$1" "${2:-}"
}

# sh_run NAME SECONDS DESCRIPTION COMMAND: one section, COMMAND run by bash -c
sh_run() {
  local -- name=$1 secs=$2 desc=$3 cmd=$4
  local -i rc=0
  sh_section "$name" "$desc"
  timeout -k 5 "$secs" bash -c "$cmd" </dev/null 2>&1 || rc=$?
  case $rc in
    0|1)     ;;   # 1 is mostly grep finding nothing
    124|137) printf '[timed out after %ss]\n' "$secs" ;;
    126|127) printf '[command not available (exit %d)]\n' "$rc" ;;
    *)       printf '[exit status %d]\n' "$rc" ;;
  esac
}

# Best-effort masking of credentials in command lines (crontabs)
sh_mask() {
  sed -E -e 's/((mysql|mysqldump|mysqladmin)[^|;&]*[[:space:]]-p)[^[:space:]]+/\1*****/g' \
         -e 's/((password|passwd|pwd|token|secret|api_?key)[[:space:]]*[=:][[:space:]]*)[^[:space:];&|]+/\1*****/Ig'
}

# Busiest processes over a 2 s sample: top's second iteration, so %CPU is
# current, not a lifetime average. Skips processes younger than 60 s and the
# collector's own session (SH_ROOT and every process below it).
sh_cpu_top() {
  local -- skip ages
  skip=$(ps -e -o pid=,ppid= | awk -v root="${SH_ROOT:-0}" '
    { parent[$1] = $2 }
    END {
      for (p in parent) {
        q = p
        while ((q in parent) && q != root && q > 1) q = parent[q]
        if (q == root) print p
      }
      print root
    }')
  ages=$(ps -e -o pid=,etimes=)
  top -b -n 2 -d 2 -w 512 -o %CPU 2>&1 | SKIP=$skip AGES=$ages awk '
    BEGIN {
      n = split(ENVIRON["SKIP"], s, "\n")
      for (i = 1; i <= n; i++) skip[s[i] + 0] = 1
      n = split(ENVIRON["AGES"], a, "\n")
      for (i = 1; i <= n; i++) { split(a[i], f, " "); age[f[1] + 0] = f[2] + 0 }
    }
    /^top - / { iteration++ }
    iteration < 2 { next }
    /^ *PID / { table = 1; print; next }
    !table { print; next }
    {
      pid = $1 + 0
      if (pid in skip) next
      # absent from the age snapshot: started since, so younger still
      if (!(pid in age) || age[pid] < 60) next
      if (++shown > 15) exit
      print
    }'
}

sh_smart() {
  local -- name type out
  local -- keys='^(Device Model|Model Number|Model Family|User Capacity|Total NVM Capacity|Rotation Rate):'
  keys+='|SMART overall-health|SMART Health Status|Reallocated_|Current_Pending|Offline_Uncorrectable'
  keys+='|Reported_Uncorrect|UDMA_CRC_Error|Power_On_Hours|Temperature_Celsius|Critical Warning'
  keys+='|Media and Data Integrity|Percentage Used|Available Spare:|^Temperature:|Power On Hours'
  keys+='|Unsafe Shutdowns|Error Information Log'
  command -v smartctl >/dev/null || { echo 'smartctl not installed'; return 0; }
  while read -r name type; do
    [[ $type == disk ]] || continue
    case $name in
      zd*|loop*|sr*|ram*|zram*) continue ;;
      *) ;;
    esac
    [[ $name =~ ^[A-Za-z0-9]+$ ]] || continue
    printf '=== /dev/%s\n' "$name"
    out=$(timeout 30 smartctl -H -i -A /dev/"$name" 2>&1)
    grep -E -- "$keys" <<< "$out" \
      || grep -vE -- '^(smartctl [0-9]|Copyright|$)' <<< "$out" | head -n 6
  done < <(lsblk -dn -o NAME,TYPE 2>/dev/null)
}

# Units with err-level journal entries in the last 24 h, with their state now
sh_error_units() {
  local -i count
  local -- unit
  printf '%6s  %-44s %s\n' errors unit 'state now'
  while read -r count unit; do
    printf '%6d  %-44s %s\n' "$count" "$unit" \
      "$(systemctl show -p ActiveState,SubState,NRestarts,ActiveEnterTimestamp -- "$unit" 2>/dev/null | paste -sd ' ')"
  done < <(journalctl -p err --since -24h -q --no-pager -o cat --output-fields=_SYSTEMD_UNIT 2>/dev/null \
             | grep -v '^$' | sort | uniq -c | sort -rn | head -n 20)
}

sh_auth() {
  local -- log
  log=$(journalctl --since -24h -q --no-pager -o short-iso SYSLOG_FACILITY=4 SYSLOG_FACILITY=10 2>/dev/null)
  [[ -n $log ]] || { echo 'no auth/authpriv journal entries in the last 24 h, or no access'; return 0; }
  printf 'failed or invalid SSH logins: %s\n' \
    "$(grep -cE 'sshd.*(Failed |Invalid user|authentication failure)' <<< "$log")"
  echo 'top sources of failures:'
  grep -E 'sshd.*(Failed |Invalid user)' <<< "$log" | grep -oE 'from [0-9A-Fa-f.:]+' \
    | sort | uniq -c | sort -rn | head -n 10
  printf 'accepted SSH logins: %s\n' "$(grep -c 'sshd.*Accepted ' <<< "$log")"
  echo 'accepted, by user and source:'
  grep -oE 'Accepted [a-z-]+ for [^ ]+ from [0-9A-Fa-f.:]+' <<< "$log" | awk '{ print $4, $6 }' \
    | sort | uniq -c | sort -rn | head -n 15
  echo 'sudo failures (newest 5):'
  grep -E 'sudo.*(incorrect password|authentication failure|NOT in sudoers)' <<< "$log" | tail -n 5
}

# chkrootkit's daily log, as changes against its accepted baseline when one exists
sh_chkrootkit() {
  local -- dir=/var/log/chkrootkit
  [[ -f $dir/log.today ]] || { echo "no chkrootkit log ($dir/log.today)"; return 0; }
  ls -l --time-style=long-iso -- "$dir"/log.today "$dir"/log.expected 2>/dev/null
  if [[ -f $dir/log.expected ]]; then
    if diff -q -- "$dir"/log.expected "$dir"/log.today >/dev/null; then
      echo 'log.today matches the accepted baseline log.expected: no change'
    else
      echo 'changes against the accepted baseline log.expected (< baseline, > today):'
      diff -- "$dir"/log.expected "$dir"/log.today | grep '^[<>]' | head -n 40
    fi
  else
    echo 'no log.expected baseline; suspicious lines in log.today:'
    grep -E -- 'INFECTED|Warning|suspicious|Possible|Vulnerable' "$dir"/log.today | head -n 40
  fi
}

sh_crontabs() {
  local -- file
  if [[ -r /var/spool/cron/crontabs ]]; then
    for file in /var/spool/cron/crontabs/*; do
      [[ -f $file ]] || continue
      printf -- '--- crontab of %s\n' "${file##*/}"
      grep -vE -- '^[[:space:]]*(#|$)' "$file" | sh_mask
    done
  else
    echo '--- crontab of this user'
    crontab -l 2>&1 | grep -vE '^[[:space:]]*(#|$)' | sh_mask
  fi
  for file in /etc/crontab /etc/cron.d/*; do
    [[ -f $file ]] || continue
    printf -- '--- %s\n' "$file"
    grep -vE -- '^[[:space:]]*(#|$)' "$file" | sh_mask
  done
  echo '--- systemd timers'
  systemctl list-timers --all --no-pager 2>&1 | head -n 40
}

# Listening sockets with their process names and PID count: ss -p lists every
# PID sharing a socket, which for web server workers runs to kilobytes a line
sh_listening() {
  printf '%-5s %-7s %-13s %-46s %s\n' proto state 'queue/backlog' address processes
  ss -Htulnp 2>&1 | awk '
    {
      users = ""; i = index($0, "users:((")
      if (i) users = substr($0, i)
      n = 0; names = ""; split("", seen)
      while (match(users, /"[^"]+",pid=[0-9]+/)) {
        item = substr(users, RSTART, RLENGTH)
        users = substr(users, RSTART + RLENGTH)
        split(item, f, "\"")
        n++
        if (!(f[2] in seen)) { seen[f[2]] = 1; names = names (names == "" ? "" : ",") f[2] }
      }
      line = sprintf("%-5s %-7s %-13s %-46s %s%s", $1, $2, $3 "/" $4, $5, names, (n > 1 ? " (" n " pids)" : ""))
      sub(/ +$/, "", line)
      # one socket per thread (SO_REUSEPORT) repeats a line: print it once, counted
      if (!(line in count)) order[++total] = line
      count[line]++
    }
    END {
      for (i = 1; i <= total; i++)
        print order[i] (count[order[i]] > 1 ? " [" count[order[i]] " sockets]" : "")
    }'
}

sh_firewall() {
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
    ufw status verbose
  elif command -v nft >/dev/null && [[ -n $(nft list ruleset 2>/dev/null) ]]; then
    nft list ruleset
  elif command -v iptables >/dev/null; then
    iptables -S 2>&1
  else
    echo 'no ufw, nft or iptables found'
  fi
  if command -v fail2ban-client >/dev/null; then
    echo '--- fail2ban'
    fail2ban-client status 2>&1
  fi
}

#shellcheck disable=SC2016  # the commands are single-quoted: bash -c runs them on the host
sh_collect() {
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
  export LC_ALL=C.UTF-8 SH_ROOT=$PPID
  declare -fx sh_mask sh_cpu_top sh_smart sh_error_units sh_auth sh_chkrootkit sh_crontabs \
    sh_listening sh_firewall

  sh_run collected_at 5 'collection time and remote user' 'date -Is; id'
  sh_run system 15 'hostnamectl, uptime, CPU count' \
    'hostnamectl | grep -vE "Machine ID|Boot ID"; uptime; printf "CPUs: %s\n" "$(nproc)"'
  sh_run pressure 5 'pressure stall information, averaged over 10/60/300 s' \
    'grep -H . /proc/pressure/cpu /proc/pressure/memory /proc/pressure/io'
  sh_run boots 90 'boot history: reboot records in wtmp, then the journal' \
    'last -x -F reboot 2>&1 | head -n 8
     echo
     { timeout 75 journalctl --list-boots --no-pager -q || echo "[journalctl --list-boots: exit $?]"; } | tail -n 8'
  sh_run kernel 30 'running kernel, reboot-required flag, Livepatch' \
    'uname -r
     if [[ -f /var/run/reboot-required ]]; then cat /var/run/reboot-required /var/run/reboot-required.pkgs 2>/dev/null
     else echo "no reboot-required flag"; fi
     command -v canonical-livepatch >/dev/null && canonical-livepatch status 2>&1 | head -n 25'
  sh_run time_sync 10 'timedatectl' 'timedatectl'

  sh_run cpu 10 'lscpu summary' \
    'lscpu | grep -E -e "^(Architecture|CPU\(s\)|Model name|Thread|Core|Socket)" \
       -e "^(NUMA node\(s\)|Virtualization|Hypervisor vendor)"'
  sh_run memory 10 'free -h; swap devices' 'free -h; echo; swapon --show'
  sh_run oom 30 'OOM kills in the kernel log, last 7 days' \
    'journalctl -k --since -7d -q --no-pager -o short-iso \
       | grep -iE "out of memory|oom-kill|killed process" | tail -n 10'
  sh_run hardware 60 'lshw -short' 'lshw -short -quiet'
  sh_run temperature 15 'sensors' 'sensors'

  sh_run filesystems 15 'df -hT, real filesystems only' \
    'df -hT -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs'
  sh_run inodes 15 'df -i, filesystems at or above 50 % inode use' \
    'df -i -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs | awk "NR == 1 || \$5 + 0 >= 50"'
  sh_run block_devices 15 'lsblk' 'lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS,ROTA,TRAN,MODEL'
  sh_run fstab 5 '/etc/fstab, active lines' 'grep -vE "^[[:space:]]*(#|$)" /etc/fstab'
  sh_run network_mounts 15 'NFS and CIFS mounts, automount units' \
    'findmnt -t nfs,nfs4,cifs,smb3 -o TARGET,SOURCE,FSTYPE,OPTIONS
     systemctl list-units --type=automount --all --no-legend --no-pager'
  sh_run raid 15 '/proc/mdstat, mdadm --detail --scan' \
    'cat /proc/mdstat 2>/dev/null || echo "no /proc/mdstat"
     command -v mdadm >/dev/null && mdadm --detail --scan'
  sh_run lvm 20 'lvs, vgs, pvs' \
    'command -v lvs >/dev/null || { echo "LVM tools not installed"; exit 0; }
     lvs -a -o lv_name,vg_name,lv_attr,lv_size,data_percent,metadata_percent,devices; vgs; pvs'
  sh_run zfs 20 'zpool status -x' 'if command -v zpool >/dev/null; then zpool status -x; else echo "no ZFS"; fi'
  sh_run smart 300 'SMART health and key attributes of each physical disk' sh_smart

  sh_run cpu_processes 30 \
    'busiest processes in a 2 s sample (top iteration 2), without processes under 60 s old or this collector' \
    sh_cpu_top
  sh_run memory_processes 10 'largest processes by resident memory (RSS in KiB, elapsed seconds)' \
    'ps -eo pid,user,rss,%mem,etimes,comm --sort=-rss | head -n 11'
  sh_run process_states 10 'process count, zombie processes' \
    'printf "processes: %s\n" "$(ps -e --no-headers | wc -l)"
