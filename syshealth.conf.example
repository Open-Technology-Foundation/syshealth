# /etc/syshealth/syshealth.conf, or ~/.config/syshealth/syshealth.conf
#
# Sourced as Bash: plain assignments only (no 'declare'). Used only when owned
# by root or the user running syshealth and not writable by group or others;
# a file holding API keys should be mode 0600 or 0640.
# Precedence: built-in defaults < this file < environment < command line.

# --- API keys ---------------------------------------------------------------
# A key set in the environment wins over one set here.
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#GEMINI_API_KEY=...
#DEEPSEEK_API_KEY=sk-...
#XAI_API_KEY=xai-...
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#OLLAMA_HOST=http://localhost:11434

# --- Model ------------------------------------------------------------------
# The provider follows from the name: claude-*, gpt-*/o*, gemini-*, deepseek-*,
# grok-*, anything else is an Ollama model.
#MODEL=claude-sonnet-5-5

# Output limit; 0 = provider default (Claude 32000, OpenAI 16384, others 8192).
# On Claude, thinking counts against it.
#MAX_TOKENS=0

# Claude effort: low, medium, high, xhigh or max; empty = the model's default.
#EFFORT=

# OpenAI-compatible providers only; never sent to Claude.
#TEMPERATURE=0.1

# Seconds for the API call, and for collecting one host.
#API_TIMEOUT=900
#COLLECT_TIMEOUT=600

# --- Reports ----------------------------------------------------------------
#OUTPUT_DIR=/root/syshealth
#LANGUAGE=en
#MAIL_RECIPIENTS=ops@example.com,admin@example.com
#MAIL_FROM='SysHealth <syshealth@example.com>'

# Operator notes: CONTEXT_DIR/common.md and CONTEXT_DIR/<host>.md
#CONTEXT_DIR=/etc/syshealth/hosts

# Extra commands run on every host, each its own section (120 s limit).
#EXTRA_COMMANDS=(
#  'systemctl status --no-pager myapp'
#  'cat /etc/myapp/schedule.conf'
#)

# --- Thresholds given to the model ------------------------------------------
#DISK_WARN=80
#DISK_CRIT=90
#MEM_WARN=85
#MEM_CRIT=95
# Sustained load average per CPU core (replaces 2.x's CPU_WARN)
#LOAD_WARN=1.0

# --- Size of the collected data ---------------------------------------------
#MAX_SECTION_LINES=200
#MAX_LINE_CHARS=500
